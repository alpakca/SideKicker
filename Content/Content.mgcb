
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:Windows
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:..\..\..\DefringedFontProcessor\DefringedFontProcessor\bin\Debug\net8.0\DefringedFontProcessor.dll

#---------------------------------- Content ---------------------------------#

#begin ../assets/fonts/SegoeUI_12.spritefont
/importer:FontDescriptionImporter
/processor:DefringedFontProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/processorParam:Version=1.0.0.0
/build:../assets/fonts/SegoeUI_12.spritefont;SegoeUI_12.spritefont

